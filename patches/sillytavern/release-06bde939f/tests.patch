+    test('aborts upstream fetch when client disconnects prematurely, triggering abort at most once', async () => {
+        const { Readable } = await import('node:stream');
+        let upstreamSignal;
+        let abortEventCount = 0;
+        const fetchDispatched = createDeferred();
+        const abortedDeferred = createDeferred();
+        const hangingStream = new Readable({
+            read() {},
+        });
+
+        fetchMock.mockImplementationOnce(async (url, init) => {
+            upstreamSignal = init.signal;
+            if (upstreamSignal) {
+                upstreamSignal.addEventListener('abort', () => {
+                    abortEventCount++;
+                    abortedDeferred.resolve();
+                });
+            }
+            fetchDispatched.resolve();
+            return {
+                status: 200,
+                headers: new Map([['content-type', 'application/json']]),
+                body: hangingStream,
+            };
+        });
+
+        const clientController = new AbortController();
+        const clientPromise = fetch(`${baseUrl}/nanogpt/images`, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ model: 'qwen-image', prompt: 'test' }),
+            signal: clientController.signal,
+        });
+
+        // Ensure upstream request has actually started before simulating client disconnection
+        await fetchDispatched.promise;
+        expect(upstreamSignal).toBeDefined();
+        expect(upstreamSignal.aborted).toBe(false);
+        expect(abortEventCount).toBe(0);
+
+        // Client abandons request prematurely
+        clientController.abort();
+        await expect(clientPromise).rejects.toThrow();
+
+        // Await server-side abort propagation deterministically
+        await abortedDeferred.promise;
+        expect(upstreamSignal.aborted).toBe(true);
+        expect(abortEventCount).toBe(1);
+    });
