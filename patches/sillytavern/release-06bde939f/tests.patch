+    function createDeferred() {
+        let resolve;
+        let reject;
+        const promise = new Promise((res, rej) => {
+            resolve = res;
+            reject = rej;
+        });
+        return { promise, resolve, reject };
+    }
+
+    function createHugeStream(Readable, chunk, count, onDestroy) {
+        let chunkCount = 0;
+        return new Readable({
+            read() {
+                if (chunkCount < count) {
+                    chunkCount++;
+                    this.push(chunk);
+                } else {
+                    this.push(null);
+                }
+            },
+            destroy(err, cb) {
+                if (onDestroy) {
+                    onDestroy();
+                }
+                cb(err);
+            },
+        });
+    }
+
+    function createStalledStream(Readable, initialChunk, onDestroy) {
+        let chunkPushed = false;
+        return new Readable({
+            read() {
+                if (!chunkPushed) {
+                    chunkPushed = true;
+                    this.push(initialChunk);
+                }
+            },
+            destroy(err, cb) {
+                if (onDestroy) {
+                    onDestroy();
+                }
+                cb(err);
+            },
+        });
+    }
